<Window
    x:Class="MandelbrotExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:effects="clr-namespace:MandelbrotExplorer.Effects"
    Title="Mandelbrot explorer" 
    Height="450"
    Width="800"
    UseLayoutRounding="True"
    ThemeMode="Dark">

    <Grid>

        <Border
            x:Name="Fractal"
            Background="Black"
            MouseWheel="Fractal_OnMouseWheel"
            SizeChanged="Fractal_OnSizeChanged"
            Margin="100"
            CornerRadius="100">
            
            <Border.Effect>
                
                <effects:Mandelbrot
                    x:Name="Mandelbrot"
                    BackgroundColor="#191919"
                    EscapeColor="#1254Af"
                    SetColor="#5853AF"/>
            
            </Border.Effect>
            
        </Border>
        
        <TextBlock
            x:Name="ZoomText"
            Text="Zoom x"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="10"/>
        
    </Grid>
    
</Window>